# ListWise AI - environment template.
# Copy to .env.local (never commit it):   cp .env.example .env.local
# With the defaults below the whole app runs locally with NO keys (mock mode).
# Flip one mode at a time to "live" as you finish each setup step in docs/SETUP.md.

# ---------------------------------------------------------------------------
# Modes
# ---------------------------------------------------------------------------
# mock = deterministic fake agents (free, offline) | live = real Claude API
AI_MODE=mock
# memory = in-process store, single dev server only | supabase = real Postgres + Auth
DATA_MODE=memory
# mock = fake checkout that grants Pro instantly | stripe = Stripe test mode
BILLING_MODE=mock
# Public base URL (used for Stripe redirects and auth callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Claude API (AI_MODE=live)  ->  https://console.anthropic.com
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Model IDs for the two tiers. Look up current IDs in the Anthropic models
# overview (docs.anthropic.com -> Models). SMART runs localization + compliance,
# FAST runs extraction, keywords and the quality judge.
ANTHROPIC_MODEL_SMART=
ANTHROPIC_MODEL_FAST=
# Prices in USD per million tokens, used only for the cost column in traces.
PRICE_SMART_INPUT_PER_MTOK=2
PRICE_SMART_OUTPUT_PER_MTOK=10
PRICE_FAST_INPUT_PER_MTOK=0.1
PRICE_FAST_OUTPUT_PER_MTOK=0.5

# ---------------------------------------------------------------------------
# Retrieval for the compliance knowledge base
# ---------------------------------------------------------------------------
# lexical = BM25 over knowledge/policies (no keys) | vector = pgvector in Supabase
RAG_MODE=lexical
# Embeddings provider for RAG_MODE=vector (https://www.voyageai.com)
VOYAGE_API_KEY=

# ---------------------------------------------------------------------------
# Supabase (DATA_MODE=supabase)  ->  Project Settings -> API Keys
# Legacy "anon" / "service_role" keys also work in these two slots.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Stripe test mode (BILLING_MODE=stripe)  ->  https://dashboard.stripe.com/test
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` locally,
# or from the webhook endpoint you create in the dashboard for production.
STRIPE_WEBHOOK_SECRET=
# Price ID of the "ListWise Pro" monthly price (starts with price_)
STRIPE_PRICE_ID_PRO=

# ---------------------------------------------------------------------------
# Plan limits
# ---------------------------------------------------------------------------
FREE_RUNS=3
PRO_RUNS_PER_PERIOD=50
